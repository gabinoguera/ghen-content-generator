# ============================================
# GHEN Content Generator - .gitignore
# ============================================

# ============================================
# CREDENTIALS & SECRETS (CRITICAL)
# ============================================
.env
.env.*
*.env

# Google Cloud / Gmail OAuth credentials
credentials.json
token.pickle
token.json
**/token.pickle
**/credentials.json

# Service account keys (any JSON with these patterns)
*-*-*.json
client_secret*.json
*service_account*.json
*serviceaccount*.json
ghendigital*.json
archivo-final*.json

# API keys file
api_keys.txt
secrets.txt
*.pem
*.key

# ============================================
# OUTPUTS (Generated content)
# ============================================
outputs/*
!outputs/.gitkeep
!outputs/README.md

# ============================================
# PYTHON
# ============================================
# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ============================================
# IDE & EDITORS
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ============================================
# PROJECT SPECIFIC
# ============================================
# Backup folder
bk/
backup/

# GitHub context summary (auto-generated)
.github/context-summary.md

# Test files (keep test scripts, ignore test outputs)
test_outputs/
*.test.md

# Logs
*.log
logs/

# Streamlit secrets
secrets.toml
