# GHEN Content Generator - Secrets Template
# ==========================================
# Copia este archivo a .streamlit/secrets.toml y completa tus valores
# NUNCA commits el archivo secrets.toml real

# API Key de Gemini (opcional - los usuarios pueden usar la suya propia)
GEMINI_API_KEY = ""

# Credenciales WordPress por defecto (opcional)
# Los usuarios pueden configurar las suyas en la interfaz
[wordpress]
url = ""
user = ""
password = ""
